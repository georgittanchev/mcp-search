# Copy to .env (next to package.json). Both entry points read it.

# Required
BRAVE_API_KEY=
BRIGHTDATA_API_KEY=

# Optional
BRIGHTDATA_ZONE=web_unlocker2
FETCH_CHAR_BUDGET=35000
BULK_CHAR_BUDGET=40000
PDFTOTEXT=/usr/bin/pdftotext

# Brave free-plan limits, shared by every process using the key
BRAVE_MONTHLY_LIMIT=2000
BRAVE_MIN_INTERVAL_MS=1100

# HTTP connector only (dist/http.js). Generate the secret with: openssl rand -hex 24
MCP_SECRET=
PORT=6014
BIND_HOST=127.0.0.1
BASE_PATH=/search-mcp
BLOCK_PRIVATE_ADDRESSES=true
