{
  "name": "web-tools-mcp-server",
  "version": "1.3.0",
  "description": "MCP server for web search (Brave Search API) and page reading (BrightData Web Unlocker, converted to clean markdown)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^5.3.0",
    "linkedom": "0.18.14",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "undici": "^7.22.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.3",
    "@types/turndown": "5.0.6",
    "typescript": "^5.8.3"
  },
  "author": "Georgi Tanchev (https://tanchev.net)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/georgittanchev/mcp-search.git"
  },
  "homepage": "https://github.com/georgittanchev/mcp-search",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "brave-search",
    "brightdata",
    "web-scraping",
    "markdown"
  ],
  "bin": {
    "web-tools-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=18"
  }
